#[[Append a group of object targets in the original source-name order.
   Only target metadata is inspected; no module source is compiled here.]]
function(hc32_ordered_objects executable)
    set(objects "")
    set(names "")
    foreach(alias IN LISTS ARGN)
        get_target_property(real ${alias} ALIASED_TARGET)
        get_target_property(sources ${real} SOURCES)
        foreach(source IN LISTS sources)
            get_filename_component(name "${source}" NAME)
            list(APPEND names "${name}")
        endforeach()
        list(APPEND objects "$<TARGET_OBJECTS:${alias}>")
    endforeach()
    list(SORT names)
    foreach(name IN LISTS names)
        string(REPLACE "." "[.]" pattern "${name}")
        target_sources(${executable} PRIVATE "$<FILTER:${objects},INCLUDE,/${pattern}[.]obj$>")
    endforeach()
endfunction()

#[[Compose firmware objects without changing the historical linker input order.]]
function(hc32_firmware_objects executable)
    add_library(hc32_firmware_usage INTERFACE)
    add_library(hc32::firmware_usage ALIAS hc32_firmware_usage)
    set(modules cmsis peripherals system board hal power_policy state ddl
        bq40z50 millis_task mp2762a parser segger_rtt easylogger comm)
    if(PRODUCT_HAS_DISPLAY)
        list(APPEND modules app_platform display display_protocol lvgl_port panel)
    endif()
    foreach(module IN LISTS modules)
        target_link_libraries(hc32_firmware_usage INTERFACE hc32::${module})
    endforeach()
    target_link_libraries(${executable} PRIVATE hc32::firmware_usage)
    if(PRODUCT_HAS_DISPLAY)
        foreach(module bq40z50 millis_task mp2762a parser segger_rtt easylogger)
            target_sources(${executable} PRIVATE $<TARGET_OBJECTS:hc32::${module}>)
        endforeach()
        target_sources(${executable} PRIVATE $<TARGET_OBJECTS:hc32::app_platform>)
        set(display_objects "$<TARGET_OBJECTS:hc32::display>;$<TARGET_OBJECTS:hc32::display_protocol>;$<TARGET_OBJECTS:hc32::lvgl_port>;$<TARGET_OBJECTS:hc32::panel>")
        foreach(name display_main display_protocol HAL_Display lvgl_new lv_port lv_port_disp PanelRm690a0 board_display)
            target_sources(${executable} PRIVATE "$<FILTER:${display_objects},INCLUDE,/${name}[.]cpp[.]obj$>")
        endforeach()
        target_sources(${executable} PRIVATE $<TARGET_OBJECTS:hc32::cmsis>)
        hc32_ordered_objects(${executable} hc32::peripherals)
        hc32_ordered_objects(${executable} hc32::system)
        hc32_ordered_objects(${executable} hc32::board)
        hc32_ordered_objects(${executable} hc32::hal hc32::power_policy)
        hc32_ordered_objects(${executable} hc32::state)
        hc32_ordered_objects(${executable} hc32::ddl)
        foreach(name slave_i2c panel_protocol)
            target_sources(${executable} PRIVATE
                "$<FILTER:$<TARGET_OBJECTS:hc32::comm>,INCLUDE,/${name}[.]cpp[.]obj$>")
        endforeach()
    else()
        foreach(module bq40z50 millis_task mp2762a parser segger_rtt easylogger)
            target_sources(${executable} PRIVATE $<TARGET_OBJECTS:hc32::${module}>)
        endforeach()
        target_sources(${executable} PRIVATE $<TARGET_OBJECTS:hc32::product_x1>)
        target_sources(${executable} PRIVATE $<TARGET_OBJECTS:hc32::multibutton>)
        target_sources(${executable} PRIVATE $<TARGET_OBJECTS:hc32::cmsis>)
        hc32_ordered_objects(${executable} hc32::peripherals)
        hc32_ordered_objects(${executable} hc32::system)
        hc32_ordered_objects(${executable} hc32::board)
        hc32_ordered_objects(${executable} hc32::hal hc32::power_policy)
        hc32_ordered_objects(${executable} hc32::state)
        hc32_ordered_objects(${executable} hc32::ddl)
        # Comm 的历史顺序为 slave_i2c、panel_protocol。
        foreach(name slave_i2c panel_protocol)
            target_sources(${executable} PRIVATE
                "$<FILTER:$<TARGET_OBJECTS:hc32::comm>,INCLUDE,/${name}[.]cpp[.]obj$>")
        endforeach()
    endif()
endfunction()
