# 便携目标由所属目录维护；调用方只选择产品、端口与需要的组件。
include_guard(GLOBAL)
get_filename_component(HC32_PORTABLE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

#[[Create one isolated set of portable HC32 targets for a product and hardware port.
   The prefix is empty for firmware/simulator and distinct for each host fixture.]]
function(hc32_add_portable prefix product port)
    cmake_parse_arguments(PORTABLE "DRIVERS;DISPLAY;SPI;GPIO;CLOCK;HEAP;FIRMWARE" "" "" ${ARGN})
    set(HC32_PREFIX "${prefix}")
    set(HC32_PRODUCT "${product}")
    set(HC32_PORT "${port}")
    if(PORTABLE_FIRMWARE)
        set(HC32_PORTABLE FALSE)
        set(PORTABLE_DRIVERS TRUE)
    else()
        set(HC32_PORTABLE TRUE)
    endif()
    if(PORTABLE_CLOCK OR PORTABLE_HEAP)
        if(PORTABLE_HEAP)
            if(NOT TARGET hc32::segger_rtt)
                add_subdirectory("${HC32_PORTABLE_ROOT}/Libraries/SEGGER_RTT" "${CMAKE_CURRENT_BINARY_DIR}/${prefix}hc32_segger_rtt" EXCLUDE_FROM_ALL)
            endif()
        endif()
        add_subdirectory("${HC32_PORTABLE_ROOT}/Platform/System" "${CMAKE_CURRENT_BINARY_DIR}/${prefix}system" EXCLUDE_FROM_ALL)
        return()
    endif()
    if(NOT TARGET hc32::parser)
        add_subdirectory("${HC32_PORTABLE_ROOT}/Libraries/Parser" "${CMAKE_CURRENT_BINARY_DIR}/${prefix}hc32_parser" EXCLUDE_FROM_ALL)
    endif()
    foreach(module Platform/Config Platform/State Platform/HAL Comm)
        add_subdirectory("${HC32_PORTABLE_ROOT}/${module}" "${CMAKE_CURRENT_BINARY_DIR}/${prefix}${module}" EXCLUDE_FROM_ALL)
    endforeach()
    add_subdirectory("${HC32_PORTABLE_ROOT}/Platform/Peripherals" "${CMAKE_CURRENT_BINARY_DIR}/${prefix}peripherals" EXCLUDE_FROM_ALL)
    if(PORTABLE_DRIVERS)
        add_subdirectory("${HC32_PORTABLE_ROOT}/Platform/Devices" "${CMAKE_CURRENT_BINARY_DIR}/${prefix}devices" EXCLUDE_FROM_ALL)
    endif()
    if(PORTABLE_DISPLAY)
        add_subdirectory("${HC32_PORTABLE_ROOT}/Display/AppPlatform" "${CMAKE_CURRENT_BINARY_DIR}/${prefix}app_platform" EXCLUDE_FROM_ALL)
    endif()
    if(PORTABLE_SPI OR PORTABLE_DISPLAY)
        add_subdirectory("${HC32_PORTABLE_ROOT}/Display/Lvgl" "${CMAKE_CURRENT_BINARY_DIR}/${prefix}lvgl_port" EXCLUDE_FROM_ALL)
    endif()
    if(PORTABLE_SPI OR (PORTABLE_FIRMWARE AND PRODUCT_HAS_DISPLAY))
        add_subdirectory("${HC32_PORTABLE_ROOT}/Display/Panel" "${CMAKE_CURRENT_BINARY_DIR}/${prefix}panel" EXCLUDE_FROM_ALL)
    endif()
    if(PORTABLE_DISPLAY OR PORTABLE_SPI OR (PORTABLE_FIRMWARE AND PRODUCT_HAS_DISPLAY))
        add_subdirectory("${HC32_PORTABLE_ROOT}/Display" "${CMAKE_CURRENT_BINARY_DIR}/${prefix}display" EXCLUDE_FROM_ALL)
    endif()
    if(product STREQUAL "X1" AND PORTABLE_DRIVERS AND NOT PORTABLE_FIRMWARE)
        set(HC32_PROTOCOL_ONLY TRUE)
        add_subdirectory("${HC32_PORTABLE_ROOT}/Products/X1" "${CMAKE_CURRENT_BINARY_DIR}/${prefix}product" EXCLUDE_FROM_ALL)
    endif()
    if(PORTABLE_FIRMWARE)
        target_link_libraries(hc32_hardware_port INTERFACE
            hc32_hal_port hc32_peripherals_port hc32_system_port)
    endif()
endfunction()
