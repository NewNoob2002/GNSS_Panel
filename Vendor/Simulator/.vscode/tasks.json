{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Simulator",
            "type": "shell",
            "command": "cmake --preset simulator-x1pro && cmake --build --preset simulator-x1pro",
            "options": {
                "cwd": "${workspaceFolder}/../.."
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}