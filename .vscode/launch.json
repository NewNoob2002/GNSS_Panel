{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug (J-Link)",
            "cwd": "${workspaceFolder}",
            // 由 CMake Tools 当前选中的 preset 给出 ELF（build/<preset>/<前缀>_<版本>.elf）
            "executable": "${command:cmake.launchTargetPath}",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "jlink",
            "device": "HC32F460xE",
            "interface": "swd",
            "svdFile": "${workspaceFolder}/Platform/CMSIS/Device/HDSC/hc32f4xx/Source/GCC/svd/HC32F460.svd",
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                        "label": "",
                        "port": 0,
                        "type": "console"
                    }
                ]
            }
        }
    ]
}
