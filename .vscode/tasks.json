{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "cmake --preset ${input:preset} && cmake --build --preset ${input:preset}",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "rebuild",
            "type": "shell",
            "command": "cmake --preset ${input:preset} && cmake --build --preset ${input:preset} --clean-first",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "host tests",
            "type": "shell",
            "command": "cmake -S tests -B build/host-tests && cmake --build build/host-tests && ctest --test-dir build/host-tests --output-on-failure",
            "group": "test",
            "problemMatcher": "$gcc"
        }
    ],
    "inputs": [
        {
            "id": "preset",
            "type": "pickString",
            "description": "CMake preset (product-buildType)",
            "options": [
                "x1-debug",
                "x1-release",
                "x1pro-debug",
                "x1pro-release",
                "xbase-debug",
                "xbase-release"
            ],
            "default": "x1pro-debug"
        }
    ]
}
