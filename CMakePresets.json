{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "hc32",
            "hidden": true,
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi-gcc.cmake"
        },
        {
            "name": "debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_COLOR_DIAGNOSTICS": "ON"
            }
        },
        {
            "name": "simulator",
            "hidden": true,
            "inherits": [
                "base",
                "debug"
            ],
            "cacheVariables": {
                "PLATFORM": "Simulator"
            }
        },
        {
            "name": "gcc-debug",
            "displayName": "GCC Debug (X1Pro)",
            "inherits": [
                "hc32",
                "debug"
            ],
            "cacheVariables": {
                "PRODUCT": "X1Pro"
            }
        },
        {
            "name": "gcc-release",
            "displayName": "GCC Release (X1Pro)",
            "inherits": [
                "hc32",
                "release"
            ],
            "cacheVariables": {
                "PRODUCT": "X1Pro"
            }
        },
        {
            "name": "x1-debug",
            "displayName": "X1 Debug",
            "inherits": [
                "hc32",
                "debug"
            ],
            "cacheVariables": {
                "PRODUCT": "X1"
            }
        },
        {
            "name": "x1-release",
            "displayName": "X1 Release",
            "inherits": [
                "hc32",
                "release"
            ],
            "cacheVariables": {
                "PRODUCT": "X1"
            }
        },
        {
            "name": "x1pro-debug",
            "displayName": "X1Pro Debug",
            "inherits": [
                "hc32",
                "debug"
            ],
            "cacheVariables": {
                "PRODUCT": "X1Pro"
            }
        },
        {
            "name": "x1pro-release",
            "displayName": "X1Pro Release",
            "inherits": [
                "hc32",
                "release"
            ],
            "cacheVariables": {
                "PRODUCT": "X1Pro"
            }
        },
        {
            "name": "xbase-debug",
            "displayName": "XBase Debug",
            "inherits": [
                "hc32",
                "debug"
            ],
            "cacheVariables": {
                "PRODUCT": "XBase"
            }
        },
        {
            "name": "xbase-release",
            "displayName": "XBase Release",
            "inherits": [
                "hc32",
                "release"
            ],
            "cacheVariables": {
                "PRODUCT": "XBase"
            }
        },
        {
            "name": "simulator-x1pro",
            "displayName": "Simulator (X1Pro)",
            "inherits": "simulator",
            "cacheVariables": {
                "SIM_PRODUCT": "X1Pro"
            }
        },
        {
            "name": "simulator-xbase",
            "displayName": "Simulator (XBase)",
            "inherits": "simulator",
            "cacheVariables": {
                "SIM_PRODUCT": "XBase"
            }
        },
        {
            "name": "simulator-demo",
            "displayName": "Simulator (Demo backend)",
            "inherits": "simulator",
            "cacheVariables": {
                "SIM_BACKEND": "Demo"
            }
        },
        {
            "name": "linux-host",
            "displayName": "Linux Port (Host & Tests)",
            "inherits": [
                "base",
                "debug"
            ],
            "cacheVariables": {
                "PLATFORM": "Linux",
                "LINUX_APP_DISPLAY": "ON",
                "LINUX_APP_SURVEY": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "gcc-debug",
            "configurePreset": "gcc-debug"
        },
        {
            "name": "gcc-release",
            "configurePreset": "gcc-release"
        },
        {
            "name": "x1-debug",
            "configurePreset": "x1-debug"
        },
        {
            "name": "x1-release",
            "configurePreset": "x1-release"
        },
        {
            "name": "x1pro-debug",
            "configurePreset": "x1pro-debug"
        },
        {
            "name": "x1pro-release",
            "configurePreset": "x1pro-release"
        },
        {
            "name": "xbase-debug",
            "configurePreset": "xbase-debug"
        },
        {
            "name": "xbase-release",
            "configurePreset": "xbase-release"
        },
        {
            "name": "simulator-x1pro",
            "configurePreset": "simulator-x1pro"
        },
        {
            "name": "simulator-xbase",
            "configurePreset": "simulator-xbase"
        },
        {
            "name": "simulator-demo",
            "configurePreset": "simulator-demo"
        },
        {
            "name": "linux-host",
            "configurePreset": "linux-host"
        }
    ],
    "testPresets": [
        {
            "name": "linux-host",
            "configurePreset": "linux-host",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
