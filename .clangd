CompileFlags:
  CompilationDatabase: build/gcc-debug
  Add:
    - -D__PROGRAM_START=Reset_Handler
---
# X1 专属源码只出现在 X1 的编译数据库中（先执行 cmake --preset x1-debug）。
If:
  PathMatch: Vendor/HC32/Products/X1/.*
CompileFlags:
  CompilationDatabase: build/x1-debug
---
If:
  PathMatch: (Vendor/HC32|App|Frameworks|External)/.*\.cpp
CompileFlags:
  Compiler: arm-none-eabi-g++
---
If:
  PathMatch: (Vendor/HC32|App|Frameworks|External)/.*\.c
CompileFlags:
  Compiler: arm-none-eabi-gcc
---
If:
  PathMatch: External/lvgl/src/core/lv_event\.h
CompileFlags:
  Add: [-include, lvgl.h]
---
# 纯核心测试使用自身的编译数据库（先执行 cmake -S App/tests -B build/app-core-tests）。
If:
  PathMatch: ^App/tests/.*
CompileFlags:
  CompilationDatabase: build/app-core-tests
---
If:
  PathMatch: ^App/tests/.*\.cpp
CompileFlags:
  Compiler: c++
---
If:
  PathMatch: ^App/tests/.*\.c
CompileFlags:
  Compiler: cc
---
# 主机测试使用自己的替身头文件与编译参数，不继承固件编译数据库。
If:
  PathMatch: ^tests/.*
CompileFlags:
  CompilationDatabase: build/host-tests
---
If:
  PathMatch: ^tests/.*\.cpp
CompileFlags:
  Compiler: c++
---
If:
  PathMatch: ^tests/.*\.c
CompileFlags:
  Compiler: cc
---
If:
  PathMatch: ^Vendor/Simulator/.*
CompileFlags:
  CompilationDatabase: build/simulator-x1pro
---
If:
  PathMatch: ^Vendor/Simulator/.*\.cpp
CompileFlags:
  Compiler: c++
---
If:
  PathMatch: ^Vendor/Simulator/.*\.c
CompileFlags:
  Compiler: cc
---
If:
  PathMatch: ^Vendor/Linux/.*
CompileFlags:
  CompilationDatabase: build/linux-host
---
If:
  PathMatch: ^Vendor/Linux/.*\.cpp
CompileFlags:
  Compiler: c++
---
If:
  PathMatch: ^Vendor/Linux/.*\.c
CompileFlags:
  Compiler: cc
