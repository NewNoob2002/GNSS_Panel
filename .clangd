CompileFlags:
  CompilationDatabase: build/gcc-debug
  Add:
    - -D__PROGRAM_START=Reset_Handler
---
# X1 专属源码只出现在 X1 的编译数据库中（先执行 cmake --preset x1-debug）。
If:
  PathMatch: Products/X1/.*
CompileFlags:
  CompilationDatabase: build/x1-debug
---
If:
  PathMatch: (Platform|Arduino|Products|Shared|Libraries)/.*\.cpp
CompileFlags:
  Compiler: arm-none-eabi-g++
---
If:
  PathMatch: (Platform|Arduino|Products|Shared|Libraries)/.*\.c
CompileFlags:
  Compiler: arm-none-eabi-gcc
---
If:
  PathMatch: Libraries/lvgl/src/core/lv_event\.h
CompileFlags:
  Add: [-include, lvgl.h]
---
If:
  PathMatch: Libraries/Adafruit-GFX-Library/gfxfont\.h
CompileFlags:
  Add: [-include, stdint.h]
---
# 主机测试使用自己的替身头文件与编译参数，不继承固件编译数据库。
If:
  PathMatch: ^tests/.*
CompileFlags:
  CompilationDatabase: build/host-tests
---
If:
  PathMatch: ^tests/.*\.cpp
CompileFlags:
  Compiler: c++
---
If:
  PathMatch: ^tests/.*\.c
CompileFlags:
  Compiler: cc
---
If:
  PathMatch: ^Ports/RK3506/.*
CompileFlags:
  CompilationDatabase: build/rk3506-host
---
If:
  PathMatch: ^Ports/RK3506/.*\.cpp
CompileFlags:
  Compiler: c++
---
If:
  PathMatch: ^Ports/RK3506/.*\.c
CompileFlags:
  Compiler: cc
